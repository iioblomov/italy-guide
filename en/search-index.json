"",{"_index":0,"t":{"43":{"position":[[0,2]]},"45":{"position":[[0,4]]},"47":{"position":[[0,2]]}}}],["1",{"_index":2,"t":{"43":{"position":[[11,2]]}}}],["2",{"_index":6,"t":{"45":{"position":[[13,2]]}}}],["agenzia",{"_index":7,"t":{"45":{"position":[[31,7]]}}}],["dell",{"_index":8,"t":{"45":{"position":[[39,5]]}}}],["entrat",{"_index":9,"t":{"45":{"position":[[45,7]]}}}],["альтернативн",{"_index":10,"t":{"47":{"position":[[3,14]]}}}],["вариант",{"_index":1,"t":{"43":{"position":[[3,7]]},"45":{"position":[[5,7]]}}}],["иммиграцион",{"_index":11,"t":{"47":{"position":[[18,14]]}}}],["итал",{"_index":5,"t":{"43":{"position":[[47,6]]},"45":{"position":[[18,6]]}}}],["консульств",{"_index":4,"t":{"43":{"position":[[35,11]]}}}],["пут",{"_index":12,"t":{"47":{"position":[[33,4]]}}}],["стран",{"_index":3,"t":{"43":{"position":[[22,6]]}}}]],"pipeline":["stemmer-ru","stemmer"]}},{"documents":[{"i":42,"t":"Codice Fiscale — один из важнейших документов для жизни в Италии. Он нужен во многих повседневных ситуациях: Покупка долгосрочного абонемента на автобус, метро ли ж/д. Покупка и длительная аренда жилья. Открытие счета в итальянском банке. Что можно оформить БЕЗ codice fiscale (по загранпаспорту): Препейд SIM-карту Краткосрочную аренду (Booking, Airbnb) Разовые билеты на транспорт Получить Codice Fiscale можно бесплатно двумя способами: в своей стране непосредственно в Италии","s":"Как получить Codice Fiscale (ИНН в Италии)","u":"/italy-guide/en/guide/business/codice-fiscale","h":"","p":41},{"i":44,"t":"Найдите сайт Консульства Италии в вашей стране проживания. Скачайте и заполните анкету (заявление) по форме AA4/8. Заполнять нужно заглавными латинскими буквами строго как в загранпаспорте. Отправьте документы по электронной почте в консульский отдел (или запишитесь на личный прием, если этого требуют правила конкретного консульства). Пакет документов: Заполненная и подписанная анкета скан загранпаспорта (разворот с фото) копия внутреннего паспорта с пропиской (если подаетесь в стране гражданства). Получите ответ. В течение нескольких дней консульство пришлет вам сертификат с кодом в формате PDF.","s":"🏠 Вариант 1. В своей стране через Консульство Италии","u":"/italy-guide/en/guide/business/codice-fiscale","h":"#-вариант-1-в-своей-стране-через-консульство-италии","p":41},{"i":46,"t":"Утром (!) зайдите на сайт налоговой службы в раздел Записаться на прием ↗️ Выберите сервис: Assistenza fiscale → Identificativi fiscali, abilitazioni, consegna documenti e istanze. Далее, выберите тип записи: Appuntamento per i prossimi giorni [рекомендуем] - запись на конкретную дату и время, или: Webticket valido per oggi [если срочно] - билет на сегодня в режиме живой очереди. Нажмите на кнопку Prenota, и на открывшейся странице выберите: Per te stesso / Per conto di - запись для себя / для другого человека Поставьте галочку ✅ Prima richiesta di codice fiscale - первичный запрос кода Поставьте галочку ✅ Ho letto l'informativa, что вы принимаете условия: Нажмите Avanti (Продолжить). Придите лично с документами: Действующий загранпаспорт (+ копия). Действующая виза или действующий вид на жительство (Permesso di soggiorno), если применимо. Заполненная форма заявления AA4/8 (бланки также лежат на стойках информации в самом офисе). Выдача кода: Сотрудник проверит документы и сразу же распечатает вам лист формата А4 со штрих-кодом — это и есть ваш бумажный Codice Fiscale. Пластиковая карта (Tessera Sanitaria) позже придет по почте на ваш итальянский адрес, если у вас будет оформлен ВНЖ и медицинская страховка.","s":"🇮🇹 Вариант 2. В Италии через Agenzia delle Entrate","u":"/italy-guide/en/guide/business/codice-fiscale","h":"#-вариант-2-в-италии-через-agenzia-delle-entrate","p":41},{"i":48,"t":"Если вы въезжаете в Италию по работе или для воссоединения семьи, код присваивается автоматически через Единое иммиграционное окно (Sportello Unico per l'immigrazione). Если вы запрашиваете убежище, код выдается в полиции (Questura) и фиксируется в форме Modello C3.","s":"⚠️ Альтернативные иммиграционные пути","u":"/italy-guide/en/guide/business/codice-fiscale","h":"#️-альтернативные-иммиграционные-пути","p":41},{"i":51,"t":"Текст статьи","s":"ВНЖ с пассивным доходом","u":"/italy-guide/en/guide/residence-permit/passive-income","h":"","p":50}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/42",[0,1.408,1,1.408,2,0.916,3,1.45,4,0.564,5,1.45,6,0.764,7,1.45,8,1.45,9,1.45,10,1.45,11,1.966,12,1.45,13,1.45,14,1.45,15,1.45,16,1.45,17,1.45,18,1.966,19,1.45,20,1.45,21,1.45,22,0.916,23,1.45,24,1.45,25,0.564,26,1.45,27,1.45,28,0.916,29,1.45,30,1.45,31,1.45,32,1.45,33,0.916,34,1.45,35,0.916,36,1.45,37,1.45,38,1.45,39,0.916,40,1.45]],["t/44",[4,0.722,6,0.518,25,0.722,35,0.842,39,1.172,41,1.334,42,0.842,43,2.134,44,1.334,45,1.334,46,1.334,47,1.334,48,1.856,49,0.842,50,0.518,51,0.842,52,1.334,53,1.334,54,1.334,55,1.334,56,1.334,57,1.334,58,1.334,59,0.842,60,1.334,61,1.334,62,1.334,63,0.842,64,0.842,65,1.334,66,1.334,67,0.842,68,1.334,69,0.842,70,1.334,71,1.334,72,1.334,73,1.334,74,0.842,75,1.334,76,1.334,77,1.334,78,1.334,79,1.334,80,1.334,81,1.334,82,1.334,83,1.334,84,1.334,85,1.334,86,0.518,87,0.842,88,1.334]],["t/46",[0,0.845,1,1.04,2,1.5,4,0.52,22,0.541,25,0.333,28,0.541,33,0.541,42,0.541,49,0.541,50,0.333,51,0.541,59,0.541,63,0.541,64,0.541,67,0.541,69,0.541,74,0.541,86,0.64,87,0.541,89,0.857,90,0.857,91,0.857,92,0.857,93,0.857,94,0.857,95,1.646,96,0.857,97,0.857,98,0.857,99,0.857,100,0.857,101,0.857,102,0.857,103,0.857,104,0.857,105,0.857,106,0.857,107,0.857,108,0.857,109,1.175,110,0.857,111,0.857,112,0.857,113,1.338,114,0.857,115,0.857,116,0.857,117,0.857,118,0.857,119,0.857,120,0.857,121,0.857,122,1.338,123,0.857,124,0.857,125,0.857,126,0.857,127,0.857,128,0.857,129,0.857,130,1.646,131,0.857,132,0.857,133,1.338,134,1.338,135,0.857,136,0.857,137,0.857,138,0.857,139,0.857,140,0.857,141,0.857,142,0.857,143,0.857,144,0.857,145,0.857,146,0.857,147,1.646,148,0.857,149,0.857,150,0.857,151,0.857,152,0.857,153,0.857,154,0.857,155,0.857,1