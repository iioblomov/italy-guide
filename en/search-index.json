"",{"_index":0,"t":{"30":{"position":[[0,2]]},"32":{"position":[[0,2]]},"34":{"position":[[0,2]]}}}],["1",{"_index":2,"t":{"30":{"position":[[11,2]]}}}],["2",{"_index":6,"t":{"32":{"position":[[11,2]]}}}],["agenzia",{"_index":7,"t":{"32":{"position":[[29,7]]}}}],["dell",{"_index":8,"t":{"32":{"position":[[37,5]]}}}],["entrat",{"_index":9,"t":{"32":{"position":[[43,7]]}}}],["альтернативн",{"_index":10,"t":{"34":{"position":[[3,14]]}}}],["вариант",{"_index":1,"t":{"30":{"position":[[3,7]]},"32":{"position":[[3,7]]}}}],["иммиграцион",{"_index":11,"t":{"34":{"position":[[18,14]]}}}],["итал",{"_index":5,"t":{"30":{"position":[[47,6]]},"32":{"position":[[16,6]]}}}],["консульств",{"_index":4,"t":{"30":{"position":[[35,11]]}}}],["пут",{"_index":12,"t":{"34":{"position":[[33,4]]}}}],["стран",{"_index":3,"t":{"30":{"position":[[22,6]]}}}]],"pipeline":["stemmer-ru","stemmer"]}},{"documents":[{"i":29,"t":"Codice Fiscale — один из важнейших документов для жизни в Италии. Он нужен во многих повседневных ситуациях: Покупка долгосрочного проездного абонемента на автобус, метро ли ж/д. Покупка и длительная аренда жилья. Открытие счета в итальянском банке. Что можно оформить БЕЗ codice fiscale (по загранпаспорту): Препейд SIM-карту Краткосрочную аренду (Booking, Airbnb) Разовые билеты на транспорт Получить Codice Fiscale можно бесплатно двумя способами: находясь в своей стране (до отъезда) или непосредственно в Италии.","s":"Как получить Codice Fiscale (ИНН в Италии)","u":"/italy-guide/en/guide/business/codice-fiscale","h":"","p":28},{"i":31,"t":"Найдите сайт Консульства Италии в вашей стране проживания. Скачайте и заполните анкету (заявление) по форме AA4/8. Заполнять нужно заглавными латинскими буквами строго как в загранпаспорте. Отправьте документы по электронной почте в консульский отдел (или запишитесь на личный прием, если этого требуют правила конкретного консульства). Пакет документов: Заполненная и подписанная анкета скан загранпаспорта (разворот с фото) копия внутреннего паспорта с пропиской (если подаетесь в стране гражданства). Получите ответ. В течение нескольких дней консульство пришлет вам сертификат с кодом в формате PDF.","s":"💡 Вариант 1. В своей стране через Консульство Италии","u":"/italy-guide/en/guide/business/codice-fiscale","h":"#-вариант-1-в-своей-стране-через-консульство-италии","p":28},{"i":33,"t":"Зайдите на сайт налоговой службы, в раздел Записаться на прием ↗️ Выберите сервис: Assistenza fiscale → Identificativi fiscali, abilitazioni, consegna documenti e istanze. Далее, выберите тип записи: Appuntamento per i prossimi giorni (рекомендуем) - запись на конкретную дату и время, или: Webticket valido per oggi (если срочно) - билет на сегодня в режиме живой очереди. Нажмите на кнопку Prenota, и на открывшейся странице выберите: Per te stesso / Per conto di - запись для себя / для другого человека Поставьте галочку ✅ Prima richiesta di codice fiscale - первичный запрос кода Поставьте галочку ✅ Ho letto l'informativa, что вы принимаете условия: Нажмите Avanti (Продолжить). Придите лично с документами: Действующий загранпаспорт (+ копия). Действующая виза или действующий вид на жительство (Permesso di soggiorno), если применимо. Заполненная форма заявления AA4/8 (бланки также лежат на стойках информации в самом офисе). Выдача кода: Сотрудник проверит документы и сразу же распечатает вам лист формата А4 со штрих-кодом — это и есть ваш бумажный Codice Fiscale. Пластиковая карта (Tessera Sanitaria) позже придет по почте на ваш итальянский адрес, если у вас будет оформлен ВНЖ и медицинская страховка.","s":"🏢 Вариант 2. В Италии через Agenzia delle Entrate","u":"/italy-guide/en/guide/business/codice-fiscale","h":"#-вариант-2-в-италии-через-agenzia-delle-entrate","p":28},{"i":35,"t":"Если вы въезжаете в Италию по работе или для воссоединения семьи, код присваивается автоматически через Единое иммиграционное окно (Sportello Unico per l'immigrazione). Если вы запрашиваете убежище, код выдается в полиции (Questura) и фиксируется в форме Modello C3.","s":"⚠️ Альтернативные иммиграционные пути","u":"/italy-guide/en/guide/business/codice-fiscale","h":"#️-альтернативные-иммиграционные-пути","p":28},{"i":52,"t":"Текст статьи","s":"ВНЖ с пассивным доходом","u":"/italy-guide/en/guide/residence-permit/passive-income","h":"","p":51}],"index":{"version":"2.3.9","fields":["t"],"fieldVectors":[["t/29",[0,1.392,1,1.392,2,0.896,3,1.419,4,0.552,5,1.419,6,0.753,7,1.419,8,1.419,9,1.419,10,1.419,11,1.936,12,1.419,13,1.419,14,1.419,15,1.419,16,1.419,17,1.419,18,1.419,19,1.936,20,1.419,21,1.419,22,1.419,23,0.896,24,1.419,25,1.419,26,0.552,27,1.419,28,1.419,29,0.896,30,1.419,31,1.419,32,1.419,33,1.419,34,0.896,35,1.419,36,0.896,37,1.419,38,1.419,39,1.419,40,1.419,41,0.896,42,1.419,43,1.419]],["t/31",[4,0.722,6,0.519,26,0.722,36,0.844,41,1.173,44,1.336,45,0.844,46,2.136,47,1.336,48,1.336,49,1.336,50,1.336,51,1.858,52,0.844,53,0.519,54,0.844,55,1.336,56,1.336,57,1.336,58,1.336,59,1.336,60,1.336,61,1.336,62,0.844,63,1.336,64,1.336,65,1.336,66,0.844,67,0.844,68,1.336,69,1.336,70,0.844,71,1.336,72,0.844,73,1.336,74,1.336,75,1.336,76,1.336,77,0.844,78,1.336,79,1.336,80,1.336,81,1.336,82,1.336,83,1.336,84,1.336,85,1.336,86,1.336,87,1.336,88,1.336,89,0.519,90,0.844,91,1.336]],["t/33",[0,0.853,1,1.047,2,1.465,4,0.525,23,0.548,26,0.337,29,0.548,34,0.548,45,0.548,52,0.548,53,0.337,54,0.548,62,0.548,66,0.548,67,0.548,70,0.548,72,0.548,77,0.548,89,0.645,90,0.548,92,0.867,93,0.867,94,0.867,95,0.867,96,0.867,97,1.659,98,0.867,99,0.867,100,0.867,101,0.867,102,0.867,103,0.867,104,0.867,105,0.867,106,0.867,107,0.867,108,0.867,109,0.867,110,0.867,111,1.182,112,0.867,113,0.867,114,0.867,115,1.35,116,0.867,117,0.867,118,0.867,119,0.867,120,0.867,121,0.867,122,0.867,123,0.867,124,1.35,125,0.867,126,0.867,127,0.867,128,0.867,129,0.867,130,0.867,131,0.867,132,1.659,133,0.867,134,0.867,135,1.35,136,1.35,137,0.867,138,0.867,139,0.867,140,0.867,141,0.867,142,0.867,143,0.867,144,0.867,145,0.867,146,0.867,147,0.867,148,0.867,149,1.659,150,